# ====================================================================
# TOOLBOX WORD - PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# IMPORTANT: Never commit real keys, secrets or passwords to Git.
# ====================================================================

# PostgreSQL Database Connection String (Neon / Production)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Session Encryption & Cryptographic Token Secret (32+ character random string)
SESSION_SECRET=

# Google Gemini AI Studio API Key (Server-side only)
GEMINI_API_KEY=

# Public Application URL
APP_URL=https://toolbox-word.vercel.app

# Runtime Environment (development | production)
NODE_ENV=production

# Optional CLI Bootstrap Variables (Only used when running npm run bootstrap:superadmin)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
